# Copy to .env (git-ignored). NEVER commit real keys.

# mock | anthropic | openai   (default: mock - runs with no key)
LLM_PROVIDER=mock
# mock | local   (tests and CI always force mock)
EMBEDDINGS_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# auto | docker | local
SANDBOX_MODE=auto

# Comma-separated feature plugins to load
PLUGINS=

PORT=3001
DATABASE_PATH=./data/gyan.db
MAX_TOOL_CALLS=8

# Edges below this confidence are not counted in coverage or flags (tune with pnpm eval)
EDGE_MIN_CONFIDENCE=0.5
# Quotes must fuzzy-match their source at least this well to count as verified
QUOTE_MATCH_MIN=0.9
